# ============================================================
# MUTUEL TOGO - Exemple de configuration
# Copiez ce fichier en ".env.local" puis remplissez vos valeurs.
# NE COMMITTEZ JAMAIS .env.local (il est ignore par Git).
# ============================================================

# --- Base de donnees ------------------------------------------------------
# Par defaut (aucune valeur) : PostgreSQL embarque (PGlite), zero installation.
# Les donnees locales sont stockees dans le dossier ./.data/pglite
# DATABASE_URL=""

# Production (ou test avec docker-compose.postgres.yml) : vrai PostgreSQL.
# Le meme code SQL est utilise dans les deux modes.
# DATABASE_URL="postgresql://mutuel:changez-moi@localhost:5432/mutuel_togo"

# --- Securite ---------------------------------------------------------------
# Secret de signature des sessions (minimum 32 caracteres, aleatoire)
# Generation : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="remplacez-par-un-secret-aleatoire-tres-long-minimum-32-caracteres"

# Cookie de session : laissez vide en local (automatique selon HTTP/HTTPS).
# En production derriere HTTPS, mettez COOKIE_SECURE="true"
COOKIE_SECURE=""

# Compte administrateur cree automatiquement au premier demarrage.
# Le mot de passe n'est utilise qu'a la premiere creation.
# L'admin pourra ensuite le changer depuis son profil back-office.
ADMIN_EMAIL="admin@mutuel.togo"
ADMIN_PASSWORD="saisissez-ici-le-mot-de-passe-admin-initial"
ADMIN_NAME="Administration MUTUEL TOGO"

# URL publique du site (SEO, sitemap). En local sur votre Wi-Fi,
# remplacez localhost par l'adresse IP locale de votre PC.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stockage des pieces (photo portrait, CNI, Pieces jointes messages)
# "local" = dossier prive du serveur. La couche src/server/storage.ts
# est prete pour un stockage cloud ulterieur.
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES="5242880"
